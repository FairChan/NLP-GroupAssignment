{
  "data_path": "data/raw/train.csv",
  "teacher_dir": "artifacts/teacher_best",
  "output_dir": "artifacts/student_tinybert_distilled",
  "model_name": "huawei-noah/TinyBERT_General_4L_312D",
  "labels": ["toxic", "severe_toxic", "obscene", "threat", "insult", "identity_hate"],
  "max_length": 192,
  "max_length_ab": [128, 192, 256],
  "head_tokens": 150,
  "tail_tokens": 40,
  "batch_size": 16,
  "eval_batch_size": 32,
  "gradient_accumulation_steps": 2,
  "epochs": 4,
  "lr": 0.00005,
  "weight_decay": 0.01,
  "warmup_ratio": 0.06,
  "supervised_loss": "asl",
  "distillation_alpha": 0.5,
  "temperature": 3.0,
  "asymmetric_loss": {
    "gamma_pos": 0.0,
    "gamma_neg": 4.0,
    "clip": 0.05
  },
  "valid_size": 0.1,
  "fp16": true,
  "num_workers": 0,
  "supplemental_data": {
    "neutral_identity_csv": "data/aux/identity_neutral.csv",
    "toxigen_csv": "data/aux/toxigen_weak.csv"
  },
  "release_gate": {
    "baseline_model_dir": "artifacts/distilbert_repro",
    "min_macro_f1": 0.726,
    "min_macro_improvement": 0.0,
    "long_tail_labels": ["threat", "identity_hate"],
    "max_model_size_mb": 90,
    "speed_first": true
  }
}
